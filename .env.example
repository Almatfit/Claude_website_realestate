# GoHighLevel (LeadConnector) credentials used by src/app/api/lead/route.ts
# to upsert website leads as contacts. Server-only — never exposed to the
# client. Copy this file to .env.local for local development and fill in
# real values; set the same two variables in your deployment platform's
# environment settings for production.

GHL_TOKEN=
GHL_LOCATION_ID=

# Tracking IDs (public — inlined into the client bundle at build time, so
# redeploy after changing them). Leave both empty and the site loads no
# tracking and shows no cookie banner. GA4 measurement ID looks like
# G-XXXXXXXXXX; the Meta pixel ID is a long number from Events Manager.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
